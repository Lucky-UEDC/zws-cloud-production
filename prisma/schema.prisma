generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminProfile {
  id                   String                            @id @default(cuid())
  email                String                            @unique
  username             String                            @unique
  displayName          String
  hashedPassword       String
  role                 String                            @default("admin")
  roleId               String?                           @map("role_id")
  trustedAdmin         Boolean                           @default(false) @map("trusted_admin")
  isActive             Boolean                           @default(true)
  phone                String?
  phoneVerified        Boolean                           @default(false)
  phoneVerifiedAt      DateTime?
  whatsappMfaEnabled   Boolean                           @default(false)
  twoFactorEnabled     Boolean                           @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes Json?
  twoFactorEnabledAt   DateTime?
  createdAt            DateTime                          @default(now())
  updatedAt            DateTime                          @updatedAt
  lastLogin            DateTime?
  roleRef              Role?                             @relation(fields: [roleId], references: [id])
  auditLogs            AuditLog[]                        @relation("audit_actor_admin")
  ticketMessages       SupportTicketMessage[]            @relation("ticket_message_admin")
  ticketAttachments    SupportTicketAttachment[]         @relation("ticket_attachment_admin")
  assignedTickets      SupportTicket[]                   @relation("ticket_assignee_admin")
  ticketsCreated       SupportTicket[]                   @relation("ticket_creator_admin")
  walletTransactions   WalletTransaction[]               @relation("wallet_actor_admin")
  impersonationTokens  AdminCustomerImpersonationToken[] @relation("impersonation_admin")

  @@index([email])
  @@index([phoneVerified])
  @@index([role, isActive])
  @@index([roleId])
  @@map("admin_profiles")
}

model Role {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  admins      AdminProfile[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  module      String
  description String?
  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Customer {
  id                        String                            @id @default(cuid())
  email                     String                            @unique
  name                      String?
  hashedPassword            String?
  isActive                  Boolean                           @default(true)
  status                    UserStatus                        @default(ACTIVE)
  suspendedAt               DateTime?
  suspendedReason           String?
  suspendUntil              DateTime?
  suspendMessage            String?
  bannedAt                  DateTime?
  bannedReason              String?
  pendingEmail              String?
  phone                     String?
  phoneNumber               String?                           @map("phone_number")
  phoneCountryCode          String?                           @map("phone_country_code")
  phoneVerified             Boolean                           @default(false)
  phoneVerifiedAt           DateTime?
  phoneVerificationAttempts Int                               @default(0) @map("phone_verification_attempts")
  phoneOtpSentAt            DateTime?                         @map("phone_otp_sent_at")
  lastLoginIp               String?                           @map("last_login_ip")
  whatsappOptIn             Boolean                           @default(true)
  whatsappLastOtp           String?
  whatsappOtpExpiresAt      DateTime?
  whatsappOtpAttempts       Int                               @default(0)
  whatsappOtpSentAt         DateTime?
  whatsappOtpCooldownUntil  DateTime?
  company                   String?
  internalNotes             String?
  accountType               AccountType                       @default(INDIVIDUAL)
  addressLine1              String?
  addressLine2              String?
  city                      String?
  state                     String?
  postalCode                String?
  country                   String?
  gstin                     String?
  panNumber                 String?
  address                   Json?
  metadata                  Json                              @default("{}")
  walletBalance             Decimal                           @default(0) @db.Decimal(12, 2)
  creditLimit               Decimal                           @default(0) @db.Decimal(12, 2)
  twoFactorEnabled          Boolean                           @default(false)
  twoFactorSecret           String?
  twoFactorBackupCodes      Json?
  twoFactorEnabledAt        DateTime?
  emailVerifiedAt           DateTime?
  createdAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt
  auditLogs                 AuditLog[]                        @relation("audit_target_customer")
  couponRedemptions         CouponRedemption[]
  customConfigs             CustomConfig[]
  dedicatedInquiries        DedicatedInquiry[]
  dedicatedServices         DedicatedService[]
  invoices                  Invoice[]
  orders                    Order[]
  checkoutIntents           CheckoutIntent[]
  checkoutSessions          CheckoutSession[]
  passwordResetTokens       PasswordResetToken[]
  payments                  Payment[]
  provisioningJobs          ProvisioningJob[]
  vmActionJobs              VmActionJob[]
  supportTicketMessages     SupportTicketMessage[]
  supportTicketAttachments  SupportTicketAttachment[]
  supportTickets            SupportTicket[]
  vpsInstances              VpsInstance[]
  upgradeRequests           VpsUpgradeRequest[]
  walletTransactions        WalletTransaction[]
  sshKeys                   SshKey[]
  emailVerificationTokens   EmailVerificationToken[]
  notificationPreferences   CustomerNotificationPreference[]
  impersonationTokens       AdminCustomerImpersonationToken[] @relation("impersonation_customer")
  backupSubscriptions       BackupSubscription[]
  backupUsages              BackupUsage[]
  backupOverages            BackupOverage[]
  backupStorageUpgrades     BackupStorageUpgrade[]
  snapshotCharges           SnapshotCharge[]

  @@unique([phoneNumber])
  @@index([email])
  @@index([isActive])
  @@index([phoneVerified])
  @@index([whatsappOptIn])
  @@index([status, suspendUntil])
  @@map("customers")
}

model PhoneVerification {
  id                String    @id @default(cuid())
  phone             String
  countryCode       String
  otpHash           String
  expiresAt         DateTime
  verifiedAt        DateTime?
  attempts          Int       @default(0)
  ip                String?
  userAgent         String?
  verificationToken String?   @unique
  whatsappMessageId String?
  deliveryStatus    String    @default("queued")
  otpCorrelationId  String?
  consumedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([phone, createdAt])
  @@index([countryCode])
  @@index([expiresAt])
  @@index([deliveryStatus])
  @@index([otpCorrelationId])
  @@index([verifiedAt])
  @@map("phone_verifications")
}

model Product {
  id                    String                  @id @default(cuid())
  slug                  String                  @unique
  name                  String
  description           String?
  shortDescription      String?
  category              String                  @default("vps")
  categoryId            String?
  subcategoryId         String?
  type                  String                  @default("fixed_vps")
  ctaMode               String                  @default("purchase_now")
  ctaLabel              String?
  badges                Json                    @default("[]")
  seoTitle              String?
  seoDescription        String?
  seoKeywords           Json                    @default("[]")
  whatsappEnabled       Boolean                 @default(false)
  visibility            String                  @default("public")
  status                String                  @default("active")
  cpuCores              Int
  ramGb                 Int
  storageGb             Int
  storageType           String                  @default("nvme")
  bandwidthTb           Decimal                 @db.Decimal(10, 2)
  price1m               Decimal                 @db.Decimal(10, 2)
  price3m               Decimal?                @db.Decimal(10, 2)
  price6m               Decimal?                @db.Decimal(10, 2)
  price12m              Decimal?                @db.Decimal(10, 2)
  price24m              Decimal?                @db.Decimal(10, 2)
  price36m              Decimal?                @db.Decimal(10, 2)
  priceHourly           Decimal?                @db.Decimal(10, 4)
  defaultCpuSockets     Int?
  defaultCoresPerSocket Int?
  nodeClassId           String?
  defaultNodeId         String?                 @map("default_node_id")
  defaultStoragePoolId  String?
  storagePoolPolicy     String?
  storagePolicyType     String                  @default("NODE_DEFAULT")
  requiredStorageType   String?
  requiredStoragePoolId String?
  allowStorageFallback  Boolean                 @default(true)
  premiumIpEnabled      Boolean                 @default(false)
  backupEnabled         Boolean                 @default(false)
  backupPrice           Decimal                 @default(0) @db.Decimal(10, 2)
  backupStorageGb       Int                     @default(0)
  snapshotEnabled       Boolean                 @default(false)
  snapshotPrice         Decimal                 @default(0) @db.Decimal(10, 2)
  snapshotIncludedCount Int                     @default(0)
  bandwidthEnabled      Boolean                 @default(true)
  bandwidthPrice        Decimal                 @default(0) @db.Decimal(10, 2)
  bandwidthLimitTb      Decimal?                @db.Decimal(10, 2)
  bandwidthOveragePrice Decimal                 @default(0) @db.Decimal(10, 2)
  extraIpv4Price        Decimal                 @default(0) @db.Decimal(10, 2)
  deletedAt             DateTime?
  isActive              Boolean                 @default(true)
  isFeatured            Boolean                 @default(false)
  sortOrder             Int                     @default(0)
  billingTerms          Json                    @default("[1, 3, 6, 12, 24, 36]")
  regions               Json                    @default("[]")
  specs                 Json                    @default("{}")
  optionGroups          Json                    @default("[]")
  serviceAttributes     Json                    @default("{}")
  features              Json                    @default("[]")
  disks                 Json                    @default("[{\"type\": \"nvme\", \"sizeGb\": 160}]")
  metadata              Json                    @default("{}")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  dedicatedInquiries    DedicatedInquiry[]
  dedicatedServices     DedicatedService[]
  orders                Order[]
  offers                Offer[]
  categoryRef           CatalogCategory?        @relation("product_category", fields: [categoryId], references: [id])
  defaultProvisionNode  ProxmoxNode?            @relation("product_default_node", fields: [defaultNodeId], references: [id])
  nodeClass             NodeClass?              @relation(fields: [nodeClassId], references: [id])
  subcategoryRef        CatalogCategory?        @relation("product_subcategory", fields: [subcategoryId], references: [id])
  vpsInstances          VpsInstance[]
  ipPools               ProductIpPool[]
  poolAssignments       PoolProductAssignment[]

  @@index([category])
  @@index([deletedAt])
  @@index([isActive])
  @@index([visibility, status, isActive, deletedAt])
  @@index([type, status])
  @@index([categoryId, subcategoryId])
  @@index([nodeClassId])
  @@index([defaultNodeId])
  @@map("products")
}

model CountryPricing {
  id               String   @id @default(cuid())
  countryCode      String   @unique
  currency         String
  markupType       String
  markupValue      Float
  exchangeOverride Float?
  roundingRule     String   @default("nearest_0_99")
  enabled          Boolean  @default(true)
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([enabled])
  @@index([currency])
  @@map("country_pricing")
}

model Offer {
  id                     String                 @id @default(cuid())
  name                   String
  slug                   String                 @unique
  headline               String?
  description            String?
  planLabel              String?
  productId              String?
  vcpu                   Int
  ramGb                  Int
  storageGb              Int
  bandwidthTb            Decimal                @default(1.00) @db.Decimal(10, 2)
  storageTier            String?
  storagePoolPolicy      String?
  storagePoolId          String?
  cpuClass               String?
  nodeClassId            String?
  region                 String?
  osTemplateId           String?
  defaultCpuSockets      Int?
  defaultCoresPerSocket  Int?
  baseMonthlyPrice       Decimal                @db.Decimal(10, 2)
  offerMonthlyPrice      Decimal                @db.Decimal(10, 2)
  gstEnabled             Boolean                @default(true)
  gstPercent             Decimal                @default(18.00) @db.Decimal(5, 2)
  billingTermsAllowed    Json                   @default("[1]")
  defaultBillingTerm     Int                    @default(1)
  maxPurchases           Int?
  purchasesCount         Int                    @default(0)
  startsAt               DateTime?
  endsAt                 DateTime?
  active                 Boolean                @default(true)
  featured               Boolean                @default(false)
  metadata               Json                   @default("{}")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  orders                 Order[]
  product                Product?               @relation(fields: [productId], references: [id])
  nodeClassRef           NodeClass?             @relation(fields: [nodeClassId], references: [id])
  osTemplate             OsTemplate?            @relation(fields: [osTemplateId], references: [id])
  proxmoxNodeStoragePool NodeStoragePoolConfig? @relation(fields: [storagePoolId], references: [id])

  @@index([active, startsAt, endsAt])
  @@index([productId])
  @@index([nodeClassId])
  @@index([osTemplateId])
  @@map("offers")
}

model NodeClass {
  id                     String        @id @default(cuid())
  name                   String
  slug                   String        @unique
  publicLabel            String?
  description            String?
  cpuModelMatch          String?
  cpuPricePerVcpuMonthly Decimal       @default(0) @db.Decimal(10, 2)
  ramPricePerGbMonthly   Decimal       @default(0) @db.Decimal(10, 2)
  cpuPricingMultiplier   Decimal?      @db.Decimal(8, 4)
  enabled                Boolean       @default(true)
  publicSelectable       Boolean       @default(false)
  sortOrder              Int           @default(0)
  metadata               Json          @default("{}")
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  offers                 Offer[]
  orders                 Order[]
  products               Product[]
  proxmoxNodes           ProxmoxNode[]
  vpsInstances           VpsInstance[]

  @@index([enabled, publicSelectable, sortOrder])
  @@map("node_classes")
}

model NodeStoragePoolConfig {
  id                   String        @id @default(cuid())
  proxmoxNodeId        String
  storageId            String
  displayName          String?
  type                 String?
  storageType          String?
  customStorageLabel   String?
  totalBytes           BigInt?
  usedBytes            BigInt?
  freeBytes            BigInt?
  availableBytes       BigInt?
  proxmoxType          String?
  enabled              Boolean       @default(true)
  defaultForNewVm      Boolean       @default(false)
  defaultForVmDisk     Boolean       @default(false)
  defaultForTemplate   Boolean       @default(false)
  defaultForBackup     Boolean       @default(false)
  premium              Boolean       @default(false)
  isPremium            Boolean       @default(false)
  allowNewPurchase     Boolean       @default(false)
  allowUpgrade         Boolean       @default(false)
  isCustomerSelectable Boolean       @default(false)
  isUpgradeOnly        Boolean       @default(false)
  pricePerGbMonthly    Decimal       @default(0) @db.Decimal(10, 2)
  minGb                Int           @default(1)
  maxGb                Int?
  priority             Int           @default(100)
  healthStatus         String        @default("unknown")
  supportedContent     Json          @default("[]")
  lastHealthCheckedAt  DateTime?
  sortOrder            Int           @default(0)
  notes                String?
  lastSyncedAt         DateTime?
  missingFromProxmox   Boolean       @default(false)
  metadata             Json          @default("{}")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  offers               Offer[]
  orders               Order[]
  proxmoxNode          ProxmoxNode   @relation(fields: [proxmoxNodeId], references: [id], onDelete: Cascade)
  vpsInstances         VpsInstance[]
  vpsDisks             VpsDisk[]

  @@unique([proxmoxNodeId, storageId])
  @@index([proxmoxNodeId, defaultForNewVm])
  @@index([proxmoxNodeId, defaultForVmDisk])
  @@index([proxmoxNodeId, defaultForTemplate])
  @@index([proxmoxNodeId, defaultForBackup])
  @@index([proxmoxNodeId, enabled])
  @@index([proxmoxNodeId, enabled, priority])
  @@map("node_storage_pool_configs")
}

model DedicatedInquiry {
  id              String    @id @default(cuid())
  inquiryNumber   String    @unique
  productId       String?
  customerId      String?
  customerEmail   String?
  customerName    String?
  customerPhone   String?
  intent          String    @default("book_now")
  sourcePath      String?
  sourceHost      String?
  status          String    @default("new")
  productSnapshot Json      @default("{}")
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  customer        Customer? @relation(fields: [customerId], references: [id])
  product         Product?  @relation(fields: [productId], references: [id])

  @@index([status, createdAt])
  @@index([productId, createdAt])
  @@index([customerId, createdAt])
  @@map("dedicated_inquiries")
}

model CatalogCategory {
  id                  String            @id @default(cuid())
  parentId            String?
  slug                String            @unique
  title               String
  description         String?
  icon                String?
  sortOrder           Int               @default(0)
  isActive            Boolean           @default(true)
  showInNav           Boolean           @default(true)
  showLandingPage     Boolean           @default(true)
  dropdownBehavior    String            @default("auto")
  visibility          String            @default("public")
  metadata            Json              @default("{}")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  parent              CatalogCategory?  @relation("catalog_category_tree", fields: [parentId], references: [id])
  children            CatalogCategory[] @relation("catalog_category_tree")
  products            Product[]         @relation("product_category")
  subcategoryProducts Product[]         @relation("product_subcategory")

  @@index([parentId, isActive, sortOrder])
  @@index([showInNav, isActive])
  @@map("catalog_categories")
}

model CustomConfig {
  id           String    @id @default(cuid())
  customerId   String?
  cpuCores     Int
  ramGb        Int
  disks        Json      @default("[{\"type\": \"nvme\", \"label\": \"Disk 1\", \"sizeGb\": 160}]")
  bandwidthTb  Decimal?  @db.Decimal(10, 2)
  termMonths   Int       @default(1)
  monthlyPrice Decimal   @db.Decimal(10, 2)
  totalPrice   Decimal   @db.Decimal(10, 2)
  status       String    @default("draft")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  customer     Customer? @relation(fields: [customerId], references: [id])
  orders       Order[]

  @@index([customerId])
  @@index([status])
  @@map("custom_configs")
}

model SshKey {
  id            String    @id @default(cuid())
  customerId    String
  label         String
  publicKey     String    @db.Text
  privateKeyEnc String?   @db.Text
  privateKeyIv  String?
  privateKeyTag String?
  fingerprint   String
  type          String    @default("ssh-ed25519")
  source        String    @default("uploaded")
  isDefault     Boolean   @default(false)
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  customer      Customer  @relation(fields: [customerId], references: [id])
  orders        Order[]

  @@unique([customerId, fingerprint])
  @@index([customerId])
  @@map("ssh_keys")
}

model Order {
  id                       String                  @id @default(cuid())
  orderNumber              String                  @unique
  customerId               String?
  productId                String?
  offerId                  String?
  customConfigId           String?
  nodeClassId              String?
  storagePoolId            String?
  orderType                String?
  termMonths               Int                     @default(1)
  unitPrice                Decimal                 @db.Decimal(10, 2)
  quantity                 Int                     @default(1)
  subtotal                 Decimal                 @db.Decimal(10, 2)
  taxAmount                Decimal                 @default(0) @db.Decimal(10, 2)
  discountAmount           Decimal                 @default(0) @db.Decimal(10, 2)
  totalAmount              Decimal                 @db.Decimal(10, 2)
  originalAmount           Decimal?                @db.Decimal(10, 2)
  finalAmount              Decimal?                @db.Decimal(10, 2)
  payableAmount            Decimal?                @db.Decimal(10, 2)
  couponCode               String?
  couponId                 String?
  offerSnapshot            Json?
  nodeClassSnapshot        Json?
  storagePoolSnapshot      Json?
  cpuSockets               Int?
  coresPerSocket           Int?
  gatewayMode              String?
  cashfreeOrderId          String?
  cashfreePaymentSessionId String?
  operatingSystemId        String?
  requestedOsFamily        String?
  requestedOsVersion       String?
  osName                   String?
  templateVmid             Int?
  proxmoxNodeId            String?
  provisioningStatus       String                  @default("pending")
  provisioningError        String?
  provisionedAt            DateTime?
  serviceId                String?
  hostname                 String?
  adminUsername            String?
  passwordEncrypted        String?
  sshPublicKey             String?
  accessMethod             String?                 @default("PASSWORD")
  sshKeyId                 String?
  currency                 String                  @default("INR")
  status                   String                  @default("pending")
  isActive                 Boolean                 @default(true)
  notes                    String?
  metadata                 Json                    @default("{}")
  vmId                     Int?
  proxmoxNode              String?
  deletedAt                DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  couponRedemptions        CouponRedemption[]
  invoices                 Invoice?
  coupon                   Coupon?                 @relation(fields: [couponId], references: [id])
  customConfig             CustomConfig?           @relation(fields: [customConfigId], references: [id])
  customer                 Customer?               @relation(fields: [customerId], references: [id])
  offer                    Offer?                  @relation(fields: [offerId], references: [id])
  nodeClass                NodeClass?              @relation(fields: [nodeClassId], references: [id])
  operatingSystem          OsTemplate?             @relation(fields: [operatingSystemId], references: [id])
  product                  Product?                @relation(fields: [productId], references: [id])
  storagePool              NodeStoragePoolConfig?  @relation(fields: [storagePoolId], references: [id])
  proxmoxServer            ProxmoxNode?            @relation(fields: [proxmoxNodeId], references: [id])
  payments                 Payment[]
  gatewayAttempts          PaymentGatewayAttempt[]
  paymentAttempts          PaymentAttempt[]
  provisioningJobs         ProvisioningJob[]
  provisioningIdentity     VmProvisioningIdentity?
  vpsInstance              VpsInstance?
  dedicatedService         DedicatedService?
  sshKey                   SshKey?                 @relation(fields: [sshKeyId], references: [id])
  walletTransactions       WalletTransaction[]

  @@index([customerId])
  @@index([status])
  @@index([couponId])
  @@index([offerId])
  @@index([nodeClassId])
  @@index([storagePoolId])
  @@index([orderType])
  @@index([cashfreeOrderId])
  @@index([operatingSystemId])
  @@index([requestedOsFamily, requestedOsVersion])
  @@index([proxmoxNodeId])
  @@index([provisioningStatus])
  @@index([isActive])
  @@index([customerId, status, createdAt])
  @@map("orders")
}

model DedicatedOsOption {
  id                String             @id @default(cuid())
  family            String
  familyLabel       String
  name              String
  version           String?
  slug              String             @unique
  iconUrl           String?
  description       String?
  defaultUsername   String?
  isActive          Boolean            @default(true)
  isRecommended     Boolean            @default(false)
  sortOrder         Int                @default(0)
  metadata          Json               @default("{}")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  dedicatedServices DedicatedService[]

  @@index([family, isActive, sortOrder])
  @@index([isActive, sortOrder])
  @@map("dedicated_os_options")
}

model DedicatedService {
  id                  String             @id @default(cuid())
  customerId          String
  orderId             String             @unique
  productId           String?
  dedicatedOsOptionId String?
  serviceNumber       String             @unique
  hostname            String?
  status              String             @default("pending_payment")
  selectedOsFamily    String?
  selectedOsName      String?
  installationNotes   String?
  sshPublicKey        String?            @db.Text
  ipmiRequired        Boolean            @default(false)
  deliverySlaHours    Int                @default(72)
  paymentConfirmedAt  DateTime?
  estimatedDeliveryAt DateTime?
  installingAt        DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  refundedAt          DateTime?
  nextRenewalAt       DateTime?
  renewalAmount       Decimal?           @db.Decimal(10, 2)
  createdAtManual     DateTime?
  activatedAtManual   DateTime?
  renewalAtManual     DateTime?
  suspendAtManual     DateTime?
  terminationAtManual DateTime?
  deletionAtManual    DateTime?
  editedByAdminId     String?
  editedAt            DateTime?
  editReason          String?
  primaryIp           String?
  username            String?
  passwordEncrypted   String?
  panelUrl            String?
  installedOs         String?
  deliveryNotes       String?            @db.Text
  metadata            Json               @default("{}")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  customer            Customer           @relation(fields: [customerId], references: [id])
  order               Order              @relation(fields: [orderId], references: [id])
  product             Product?           @relation(fields: [productId], references: [id])
  dedicatedOsOption   DedicatedOsOption? @relation(fields: [dedicatedOsOptionId], references: [id])

  @@index([customerId, status])
  @@index([productId])
  @@index([dedicatedOsOptionId])
  @@index([status, createdAt])
  @@index([editedByAdminId])
  @@map("dedicated_services")
}

model Invoice {
  id                   String                  @id @default(cuid())
  invoiceNumber        String                  @unique
  orderId              String?                 @unique
  customerId           String
  issueDate            DateTime                @default(now())
  dueDate              DateTime
  subtotal             Decimal                 @db.Decimal(10, 2)
