/// Admin Update Center: one row per release attempt (planned → running →
/// success | failed | rolled_back | apply_pending). Additive; no existing
/// billing/backup/snapshot data is touched.
model Deployment {
  id              String    @id @default(cuid())
  version         String    @map("version")
  commit          String?   @map("commit")
  image           String    @map("image")
  digest          String?   @map("digest")
  status          String    @default("planned") @map("status") // planned | running | success | failed | rolled_back | apply_pending
  stage           String?   @map("stage") // preflight | migrate | apply | health | smoke | done | host_apply
  stageOutput     Json?     @map("stage_output")
  migrationCount  Int       @default(0) @map("migration_count")
  startedBy       String?   @map("started_by")
  error           String?   @map("error")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  rollbackVersion String?   @map("rollback_version")
  metadata        Json      @default("{}") @map("metadata")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status, startedAt])
  @@map("deployments")
}
