// ---------------------------------------------------------------------------
// Guest automation (qm guest / QEMU Guest Agent) — no cloud-init dependency.
//
// Adding a new supported OS is a CONFIGURATION task: an admin creates a
// GuestOSTemplate plus its GuestOperationTemplate rows. No application code
// change is required, and the operation definitions are versioned so an
// upgrade never silently mutates an already-deployed VM.
// ---------------------------------------------------------------------------

/// One supported operating system family/version, e.g. "ubuntu" + 24.04.
model GuestOSTemplate {
  id                 String                   @id @default(cuid())
  name               String
  slug               String                   @unique
  /// QGA `get-osinfo` id-prefix set this template claims, e.g. "ubuntu", "rocky".
  family             String
  /// Comma-free list is stored in `osIds` Json; kept indexed via family.
  osIds              Json                     @default("[]")
  /// Anchored regular expression source matched against the GATEWAY OS version.
  versionPattern     String?
  enabled            Boolean                  @default(false)
  guestAgentRequired Boolean                  @default(true) @map("guest_agent_required")
  /// "linux" | "windows" — the ONLY thing that decides which engine may run.
  engine             String                   @default("linux")
  /// Higher wins when several templates match the detected OS.
  priority           Int                      @default(100)
  description        String?
  /// Bumped by the admin editor; recorded per-applied-operation.
  version            Int                      @default(1)
  lastTestedAt       DateTime?                @map("last_tested_at")
  lastTestResult     Json?                    @map("last_test_result")
  /// The Proxmox catalogue template this profile is proven against.
  ///
  /// Many-to-one, not one-to-one: one Proxmox template named `Windows Latest`
  /// backs the 2019, 2022 and 2025 guest profiles, and one `CentOS-8` image
  /// backs more than one RHEL-family profile. A unique constraint here made the
  /// link impossible to express and would have left most profiles unlinked.
  osTemplateId       String?                  @map("os_template_id")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  operations         GuestOperationTemplate[]
  osTemplate         OsTemplate?              @relation(fields: [osTemplateId], references: [id])
  vms                VmGuestAdoption[]

  @@index([family, engine, enabled])
  @@index([osTemplateId])
  @@index([enabled, priority])
  @@map("guest_os_templates")
}

/// One admin-defined, OS-specific operation (set_ip, disk_usage, ...).
model GuestOperationTemplate {
  id                   String          @id @default(cuid())
  templateId           String          @map("template_id")
  operation            String
  enabled              Boolean         @default(true)
  /// "guest-native" uses a `qm guest cmd` verb; "guest-exec" runs a shell command.
  commandType          String          @default("guest-exec") @map("command_type")
  /// linux-sh | linux-bash | windows-powershell | windows-cmd | windows-netsh
  ///
  /// Nullable on purpose: a `guest-native` operation runs no shell at all, so
  /// storing one would be an inert field that reads as though it constrained
  /// anything. The column was NOT NULL, which meant every attempt to save a
  /// guest automation template failed -- the four native operations always
  /// serialise to a null shell. Readers already treat null as "no shell" and
  /// fall back to the engine's default.
  shell                String?         @default("linux-sh")
  /// Template command body. Placeholders are resolved server-side only.
  command              String?
  /// Structured argv used when commandType is guest-native.
  arguments            Json            @default("[]")
  timeoutSeconds       Int             @default(30) @map("timeout_seconds")
  requiresRunning      Boolean         @default(true) @map("requires_running")
  requiresStopped      Boolean         @default(false) @map("requires_stopped")
  requiresGuestAgent   Boolean         @default(true) @map("requires_guest_agent")
  rebootRequired       Boolean         @default(false) @map("reboot_required")
  /// safe | caution | dangerous — gates confirmation + auto-rollback.
  dangerLevel          String          @default("safe") @map("danger_level")
  requiresConfirmation Boolean         @default(false) @map("requires_confirmation")
  supportsRollback     Boolean         @default(false) @map("supports_rollback")
  verificationRequired Boolean         @default(true) @map("verification_required")
  /// Native QGA verb used for verification, e.g. network-get-interfaces.
  verificationCommand  String?         @map("verification_command")
  /// Parser id: df-posix | win-logicaldisk | native-json | exit-code | none
  verificationParser   String?         @map("verification_parser")
  successCondition     String?         @map("success_condition")
  rollbackCommand      String?         @map("rollback_command")
  rollbackArguments    Json?           @map("rollback_arguments")
  /// Ordered alternatives attempted when the primary command fails.
  fallbacks            Json            @default("[]")
  /// Dotted state key this operation satisfies, used for idempotency checks.
  stateKey             String?         @map("state_key")
  notes                String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  template             GuestOSTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, operation])
  @@index([templateId, enabled])
  @@map("guest_operation_templates")
}

/// Per-VM record of the detected guest state + which template version is live.
model VmGuestAdoption {
  id                     String           @id @default(cuid())
  vpsInstanceId          String           @unique @map("vps_instance_id")
  osTemplateId           String?          @map("os_template_id")
  guestTemplateId        String?          @map("guest_template_id")
  appliedTemplateVersion Int?             @map("applied_template_version")
  engine                 String           @default("unknown")
  detectedOsId           String?          @map("detected_os_id")
  detectedName           String?          @map("detected_name")
  detectedVersion        String?          @map("detected_version")
  detectedKernelVersion  String?          @map("detected_kernel_version")
  /// { interfaces, filesystems, hostname, timezone, users } — last observed truth.
  state                  Json             @default("{}")
  automationReady        Boolean          @default(false) @map("automation_ready")
  guestAgentReachable    Boolean          @default(false) @map("guest_agent_reachable")
  guestAgentCheckedAt    DateTime?        @map("guest_agent_checked_at")
  unsupportedReason      String?          @map("unsupported_reason")
  recoveryRequired       Boolean          @default(false) @map("recovery_required")
  recoveryReason         String?          @map("recovery_reason")
  lastDetectedAt         DateTime?        @map("last_detected_at")
  adoptedAt              DateTime?        @map("adopted_at")
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  vpsInstance            VpsInstance      @relation(fields: [vpsInstanceId], references: [id], onDelete: Cascade)
  osTemplate             OsTemplate?      @relation(fields: [osTemplateId], references: [id])
  guestTemplate          GuestOSTemplate? @relation(fields: [guestTemplateId], references: [id])

  @@index([guestTemplateId])
  @@index([engine, automationReady])
  @@map("vm_guest_adoptions")
}

/// A planned unit of guest work (first-boot, customer change, or repair).
model GuestAutomationRun {
  id              String              @id @default(cuid())
  vpsInstanceId   String              @map("vps_instance_id")
  /// first_boot | customer_change | repair | admin_test | scheduled
  trigger         String
  /// set_ip,set_dns,... — the plan, in execution order.
  operations      Json                @default("[]")
  status          String              @default("pending") // pending|running|success|failed|partial|rolled_back
  currentStep     String?             @map("current_step")
  templateId      String?             @map("template_id")
  templateVersion Int?                @map("template_version")
  requestedBy     String?             @map("requested_by")
  requestedRole   String?             @map("requested_role")
  /// Safety net for destructive ops: old values captured before execution.
  backupPoint     Json                @default("{}") @map("backup_point")
  error           String?
  metadata        Json                @default("{}")
  startedAt       DateTime?           @map("started_at")
  completedAt     DateTime?           @map("completed_at")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  vpsInstance     VpsInstance         @relation(fields: [vpsInstanceId], references: [id], onDelete: Cascade)
  steps           GuestOperationRun[]

  @@index([vpsInstanceId, createdAt])
  @@index([status, createdAt])
  @@map("guest_automation_runs")
}

/// One executed step of a run. Secrets are NEVER written to this table.
model GuestOperationRun {
  id              String             @id @default(cuid())
  runId           String             @map("run_id")
  vpsInstanceId   String             @map("vps_instance_id")
  operation       String
  templateId      String?            @map("template_id")
  templateVersion Int?               @map("template_version")
  commandType     String?            @map("command_type")
  shell           String?            @map("shell")
  /// Masked command for display/audit — placeholders resolved, secrets redacted.
  commandMasked   String?            @map("command_masked")
  /// success | already_applied | skipped | failed | timeout | unsupported
  status          String
  changed         Boolean            @default(false)
  verified        Boolean            @default(false)
  verificationOk  Boolean            @default(false) @map("verification_ok")
  proxmoxUpid     String?            @map("proxmox_upid")
  exitCode        Int?               @map("exit_code")
  durationMs      Int?               @map("duration_ms")
  attempts        Int                @default(1)
  errorCode       String?            @map("error_code")
  error           String?
  /// Structured, non-sensitive result payload.
  result          Json               @default("{}")
  startedAt       DateTime           @default(now()) @map("started_at")
  finishedAt      DateTime?          @map("finished_at")
  createdAt       DateTime           @default(now())
  run             GuestAutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  vpsInstance     VpsInstance        @relation(fields: [vpsInstanceId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([vpsInstanceId, operation, createdAt])
  @@index([status, createdAt])
  @@map("guest_operation_runs")
}

