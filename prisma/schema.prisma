model VmUsageHistory {
  id            String   @id @default(cuid())
  vmId          String   @map("vm_id")
  cpuPercent    Float    @default(0) @map("cpu_percent")
  ramUsed       BigInt   @default(0) @map("ram_used")
  ramTotal      BigInt   @default(0) @map("ram_total")
  diskUsed      BigInt   @default(0) @map("disk_used")
  diskTotal     BigInt   @default(0) @map("disk_total")
  networkIn     BigInt   @default(0) @map("network_in")
  networkOut    BigInt   @default(0) @map("network_out")
  runtimeStatus String?  @map("runtime_status")
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")

  // Retention tiers. Raw samples are folded into 5m rows after seven days and
  // into 1h rows after thirty, so the table holds a bounded number of rows per
  // VM rather than one every thirty seconds forever. Nullable and defaulted so
  // every existing row stays valid and counts as raw.
  vpsInstanceId String?   @map("vps_instance_id")
  /// "raw" | "5m" | "1h" — the resolution of this row.
  resolution    String    @default("raw")
  /// The bucket this row represents. Null on pre-existing rows, which are raw
  /// samples whose bucket is `createdAt`.
  recordedAt    DateTime? @map("recorded_at")
  diskFree      BigInt    @default(0) @map("disk_free")
  /// How many raw samples this rollup folded. 1 on a raw row.
  sampleCount   Int       @default(1) @map("sample_count")

  @@index([vmId, createdAt])
  @@index([createdAt])
  @@index([vpsInstanceId, resolution, recordedAt])
  @@index([resolution, recordedAt])
  @@map("vm_usage_history")
}

/// Developer-platform API keys (reseller + client) for the versioned /api/v1 API.
model ApiKey {
  id              String    @id @default(cuid())
  name            String
  prefix          String
  hashedKey       String    @unique
  type            String    @default("reseller") // "reseller" | "client"
  ownerCustomerId String? // client keys are hard-scoped to this customer
  scopes          Json      @default("[]") // array of scope strings, e.g. ["vm:read","vm:write"]
  rateLimitPerMin Int       @default(120)
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([hashedKey])
  @@index([ownerCustomerId])
  @@map("api_keys")
}

/// Billable backup plan product (admin-configured; not a raw Proxmox concept).
model BackupPlan {
  id                     String   @id @default(cuid())
  name                   String
  slug                   String   @unique
  description            String?
  active                 Boolean  @default(true)
  archived               Boolean  @default(false)
  featured               Boolean  @default(false)
  price                  Decimal  @default(0) @db.Decimal(10, 2)
  currency               String   @default("INR")
  billingCycle           String   @default("monthly")
  taxPercent             Decimal  @default(18) @db.Decimal(5, 2)
  maxBackups             Int      @default(10)
  storageQuotaGb         Int      @default(100)
  manualBackupEnabled    Boolean  @default(true) @map("manual_backup_enabled")
  automaticBackupEnabled Boolean  @default(true) @map("automatic_backup_enabled")
  scheduleOptions        Json     @default("[]") @map("schedule_options")
  retentionCount         Int      @default(10) @map("retention_count")
  restoreEnabled         Boolean  @default(true) @map("restore_enabled")
  downloadEnabled        Boolean  @default(false) @map("download_enabled")
  overageEnabled         Boolean  @default(true) @map("overage_enabled")
  overagePricePerGb      Decimal  @default(0) @map("overage_price_per_gb") @db.Decimal(10, 2)
  extraStoragePricePerGb Decimal  @default(0) @map("extra_storage_price_per_gb") @db.Decimal(10, 2)
  gracePeriodDays        Int      @default(3) @map("grace_period_days")
  maxStorageCapGb        Int?     @map("max_storage_cap_gb")
  metadata               Json     @default("{}")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  subscriptions BackupSubscription[]

  @@index([active, archived])
  @@map("backup_plans")
}

/// A customer's purchased backup entitlement attached to a BackupPlan.
model BackupSubscription {
  id                     String    @id @default(cuid())
  customerId             String    @map("customer_id")
  planId                 String    @map("plan_id")
  orderId                String?   @map("order_id")
  invoiceId              String?   @map("invoice_id")
  status                 String    @default("active") // active | grace | expired | cancelled
  startedAt              DateTime  @default(now()) @map("started_at")
  expiresAt              DateTime? @map("expires_at")
  graceEndsAt            DateTime? @map("grace_ends_at")
  autoRenew              Boolean   @default(true) @map("auto_renew")
  termMonths             Int       @default(1) @map("term_months")
  upgradeStorageGb       Int       @default(0) @map("upgrade_storage_gb")
  extraStoragePricePerGb Decimal   @default(0) @map("extra_storage_price_per_gb") @db.Decimal(10, 2)
  grandfathered          Boolean   @default(false)
  metadata               Json      @default("{}")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  customer Customer               @relation(fields: [customerId], references: [id])
  plan     BackupPlan             @relation(fields: [planId], references: [id])
  usages   BackupUsage[]
  overages BackupOverage[]
  upgrades BackupStorageUpgrade[]

  @@index([customerId, status])
  @@index([status, expiresAt])
  @@map("backup_subscriptions")
}

/// Period snapshot of a subscription's storage/count consumption.
model BackupUsage {
  id             String    @id @default(cuid())
  subscriptionId String    @map("subscription_id")
  customerId     String    @map("customer_id")
  periodStart    DateTime  @default(now()) @map("period_start")
  periodEnd      DateTime? @map("period_end")
  usedBytes      BigInt    @default(0) @map("used_bytes")
  backupCount    Int       @default(0) @map("backup_count")
  quotaGb        Int       @default(0) @map("quota_gb")
  overageGb      Decimal   @default(0) @map("overage_gb") @db.Decimal(10, 2)
  computedAt     DateTime  @default(now()) @map("computed_at")
  metadata       Json      @default("{}")

  subscription BackupSubscription @relation(fields: [subscriptionId], references: [id])
  customer     Customer           @relation(fields: [customerId], references: [id])

  @@index([subscriptionId, periodStart, periodEnd])
  @@index([customerId, computedAt])
  @@map("backup_usage")
}

/// Generated billable overage line for a subscription period.
model BackupOverage {
  id             String   @id @default(cuid())
  subscriptionId String   @map("subscription_id")
  customerId     String   @map("customer_id")
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  usedBytes      BigInt   @map("used_bytes")
  quotaBytes     BigInt   @map("quota_bytes")
  overageGb      Decimal  @default(0) @map("overage_gb") @db.Decimal(10, 2)
  ratePerGb      Decimal  @default(0) @map("rate_per_gb") @db.Decimal(10, 2)
  amount         Decimal  @default(0) @db.Decimal(10, 2)
  invoiceId      String?  @map("invoice_id")
  status         String   @default("unbilled") // unbilled | billed | waived
  createdAt      DateTime @default(now()) @map("created_at")

  subscription BackupSubscription @relation(fields: [subscriptionId], references: [id])
  customer     Customer           @relation(fields: [customerId], references: [id])

  @@index([subscriptionId, status])
  @@index([customerId, status])
  @@map("backup_overages")
}

/// Purchased extra backup storage on top of a plan's included quota.
model BackupStorageUpgrade {
  id             String    @id @default(cuid())
  subscriptionId String    @map("subscription_id")
  customerId     String    @map("customer_id")
