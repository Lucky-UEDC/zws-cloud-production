# Minimal production environment.
# All service credentials are configured at runtime from the admin panel.
# Razorpay secrets are stored encrypted from Admin > Payments > Gateway Settings.
# Only the public key id may be exposed to browser checkout.

NODE_ENV=production
ZWS_RUNTIME=docker
ZWS_STARTUP_STRICT=1
SITE_DOMAIN="example.com"
APP_URL="https://example.com"
NEXTAUTH_URL="https://example.com"
NEXT_PUBLIC_APP_URL="https://example.com"

# Database mode:
# external = use the db-tunnel compose service connected to db.myrdphub.com.
# local = use the docker-compose postgres service and COMPOSE_PROFILES=local-db.
DATABASE_MODE="external"
COMPOSE_PROFILES="db-tunnel"
DATABASE_URL=""
DB_CONNECTION_LIMIT="3"
DB_POOL_TIMEOUT="20"
DB_CONNECT_TIMEOUT="10"
DB_STATEMENT_TIMEOUT_MS="10000"
DB_SLOW_QUERY_MS="100"
DOCKER_DATABASE_URL=""
DATABASE_TUNNEL_HOSTNAME="db.myrdphub.com"
DATABASE_TUNNEL_PORT="15432"
DATABASE_HOST="db-tunnel"
DATABASE_PORT="15432"
DATABASE_NAME="zwscloud"
DATABASE_USER="zwscloud_app"
DATABASE_PASSWORD="CHANGE_ME_DB_PASSWORD"
DATABASE_SSLMODE="require"
CLOUDFLARED_CONFIG_DIR="/root/.cloudflared"
TUNNEL_SERVICE_TOKEN_ID=""
TUNNEL_SERVICE_TOKEN_SECRET=""
EXTERNAL_DATABASE_URL=""
DOCKER_EXTERNAL_DATABASE_URL="postgresql://zwscloud_app:CHANGE_ME_DB_PASSWORD@db-tunnel:15432/zwscloud?schema=public&sslmode=require"
LOCAL_DATABASE_URL=""
DOCKER_LOCAL_DATABASE_URL="postgresql://zwscloud_app:CHANGE_ME_DB_PASSWORD@postgres:5432/zwscloud?schema=public"
POSTGRES_DB="zwscloud"
POSTGRES_USER="zwscloud_app"
POSTGRES_PASSWORD="CHANGE_ME_DB_PASSWORD"
REDIS_URL=""
DOCKER_REDIS_URL="redis://redis:6379/0"

# Generate strong secrets:
# openssl rand -base64 48
NEXTAUTH_SECRET="CHANGE_ME_BASE64"

# Generate a 32-byte hex encryption key:
# openssl rand -hex 32
ENCRYPTION_KEY="CHANGE_ME_32_BYTE_HEX"
MFA_ENCRYPTION_KEY="CHANGE_ME_32_BYTE_HEX"

# Google OAuth login.
# Disabled by default. Set both values to true when website Google login is installed.
GOOGLE_OAUTH_LOGIN_ENABLED="false"
NEXT_PUBLIC_GOOGLE_OAUTH_LOGIN_ENABLED="false"
# In production, Google Cloud Console must include the exact Authorized redirect URI:
# https://<production-domain>/api/auth/google/callback
# Do not add localhost redirect URIs to the production OAuth client.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# WhatsApp uses Evolution API. Secrets can also be managed from Admin > WhatsApp.
WHATSAPP_PROVIDER="evolution"
EVOLUTION_API_URL=""
EVOLUTION_INSTANCE=""
EVOLUTION_API_KEY=""
EVOLUTION_WEBHOOK_URL=""
EVOLUTION_TEST_RECIPIENT=""
# Docker runtime ownership.
VNC_PROXY_HOST="0.0.0.0"
VNC_PROXY_PORT="3001"
WORKER_HEALTH_PORT="3100"
SCHEDULER_HEALTH_PORT="3101"
CONSOLE_SESSION_REUSE_ENABLED="0"
ZWS_BACKUP_DIR="/app/backups"
ZWS_LOG_DIR="/app/logs"
DEPLOYMENT_REPORT_DIR="/app/deployment-reports"

# Production deploys must snapshot the app host before switching releases.
# The command receives ZWS_DEPLOY_COMMIT, ZWS_DEPLOY_RELEASE, ZWS_DEPLOY_BACKUP_ROOT,
# ZWS_DEPLOY_SNAPSHOT_LABEL, and ZWS_DEPLOY_SNAPSHOT_METADATA.
ZWS_APP_SNAPSHOT_COMMAND=""

# Universal installer / Cloudflare automation.
INSTALL_MODE="interactive"
CLOUDFLARE_TUNNEL_ENABLED="0"
CLOUDFLARE_ONLY_MODE="false"
DIRECT_CLOUDFLARE_MODE="false"
CF_EMAIL=""
CF_ACCOUNT_ID=""
CF_API_TOKEN=""
CF_ZONE_ID=""
CF_TUNNEL_ID=""
CLOUDFLARE_TUNNEL_NAME=""
CF_TUNNEL_NAME=""
CF_TUNNEL_TOKEN=""
CF_TUNNEL_SERVICE="http://app:3000"
CF_TUNNEL_HOSTNAMES=""
CF_DNS_RECORDS=""
CF_SSL_MODE="full"
CLOUDFLARE_ALLOW_SERVICE_RESTART="0"
PROXMOX_LIVE_SSE_POLL_MS="250"
PROXMOX_EVENT_WATCH_MS="250"
PLATFORM_HEALTH_REPAIR_INTERVAL_MS="900000"

# Ticket attachments can use rclone/Google Drive internally.
# The UI intentionally displays this backend as "Internal Storage".
GDRIVE_ATTACHMENT_STORAGE_ENABLED="0"
GDRIVE_ATTACHMENT_RCLONE_REMOTE=""
GDRIVE_ATTACHMENT_FOLDER="ZWS Ticket Attachments"
GDRIVE_ATTACHMENT_SHARED_DRIVE=""
TICKET_ATTACHMENT_DIR=""
TICKET_ATTACHMENT_MAX_BYTES="26214400"

# Production validation and telemetry workers.
BROWSER_AUTOMATION_ENABLED="1"
VM_TELEMETRY_POLL_MS="15000"
VM_TELEMETRY_CONCURRENCY="4"
LIVE_BANDWIDTH_POLL_MS="1000"
PROXMOX_LIVE_SSE_POLL_MS="1000"
PROXMOX_LIVE_SSE_MAX_LATENCY_MS="250"
LIVE_BANDWIDTH_CONFIG_REFRESH_MS="30000"
LIVE_BANDWIDTH_VM_BATCH_SIZE="500"
VM_OWNERSHIP_VERIFY_MS="600000"
TELEMETRY_HEALTH_MAX_AGE_MS="600000"
# Standard outbound WhatsApp messages: four total attempts; fixed five-minute retry delay.
# OTP and campaign queues retain their separate retry defaults.
WHATSAPP_MESSAGE_ATTEMPTS="4"
WHATSAPP_MESSAGE_RETRY_DELAY_MS="300000"

WHATSAPP_DELIVERY_MIN_ACK="1"
WHATSAPP_ACK_TIMEOUT_MS="90000"
WHATSAPP_OTP_INSTALL_TEST="0"
WHATSAPP_OTP_TEST_IN_NUMBER=""
WHATSAPP_OTP_TEST_US_NUMBER=""

# ---- Admin Update Center (Problem E) ----
# Trusted release source: GitHub repo in `owner/repo` form. Releases are only
# offered when they carry a validated release-manifest.json (semver tag, image
# allowlisted under UPDATE_IMAGE_PREFIX, sha256 digest, safe migration names).
UPDATE_GITHUB_REPO=""
UPDATE_GITHUB_TOKEN=""
UPDATE_IMAGE_PREFIX="zws-cloud"
# Host-side fixed apply script executed by the Update Center (validated args only).
UPDATE_APPLY_SCRIPT=""
# Apply script knobs (host operator): pre-update DB snapshot destination and
# app health-check URL used during smoke verification.
UPDATE_BACKUP_DIR="/var/www/backups"
UPDATE_APP_URL="http://127.0.0.1:13000"
# Build metadata for immutable images (docker-compose build args).
APP_VERSION="1.1.0"
APP_COMMIT=""
APP_SOURCE_DATE=""
